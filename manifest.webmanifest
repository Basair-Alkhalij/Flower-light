      "purpose": "any"
    },
    {
      "src": "icon-512.png?v=__FL_VERSION__",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-192-maskable.png?v=__FL_VERSION__",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icon-512-maskable.png?v=__FL_VERSION__",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "apple-touch-icon.png?v=__FL_VERSION__",
      "sizes": "180x180",
      "type": "image/png"
    }
  ],
  "display_override": [
    "standalone"
  ],
  "prefer_related_applications": false
